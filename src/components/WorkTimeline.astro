---
import '../globals.css'
import TechTag from './TechTag.astro'
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";
import { PortableText } from 'astro-portabletext';

const WORK_HISTORY_QUERY = `*[
  _type == "workHistory"
]|order(startDate desc)[0...12]{
    _id, 
    company, 
    title, 
    startDate, 
    endDate, 
    bullets,
    technologies
}`;

const monthToName = new Map([
    [0, "January"],
    [1, "February"],
    [2, "March"],
    [3, "April"],
    [4, "May"],
    [5, "June"],
    [6, "July"],
    [7, "August"],
    [8, "September"],
    [9, "October"],
    [10, "November"],
    [11, "December"]
])

const formatDate = (date: Date) => {
    date = new Date(date)
    if (!date) {
        return "Present"
    }
    return `${monthToName.get(date.getMonth())} ${date.getFullYear()}`
}

const workHistory = await sanityClient.fetch<SanityDocument[]>(WORK_HISTORY_QUERY);
---

<div>
    {
        workHistory.map((job) => (
            <div class="work-card">
                <h3 class="work-header">
                    <span class="work-header-title">
                        <div>
                            {job.title} @ {job.company}
                        </div>
                    </span>
                    <span class="work-header-dates">
                        {formatDate(job.startDate)} - {formatDate(job.endDate)}
                    </span>
                </h3>
                <div class="work-description">
                    <PortableText value={job.bullets} />
                </div>
                <div class="tech-tag-row">
                    {
                        job.technologies?.map((techName: string) => <TechTag label={techName} />)
                    }
                </div>
            </div>
        ))
    }
</div>

<style>
    .work-card {
        display: flex;
        flex-direction: column;
    }
    .work-header {
        display: flex;
        flex-wrap: wrap-reverse;
        justify-content: space-between;
        font-weight: normal;
        margin: 0 0 1em;
    }
    .work-header-title {
        padding: 0 3em 0 0;
    }
    .work-header-dates {
        font-weight: 200;
    }
    .light-title {
        font-weight: 200;
    }
    .work-description {
        margin: 0 0 1em;
    }
    .work-description ul {
        padding: 0 0 0 1em;
        margin: 0;
    }
    .tech-tag-row {
        display: flex;
        flex-direction: row;
        margin: 0 0 1em;
    }
</style>